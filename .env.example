# ---- Environnement affiché dans l'en-tête : production | staging | development
NEXT_PUBLIC_ZIRA_ENV=development

# ---- Mode démo (données fictives, aucun accès Firebase). Interdit en production.
# Laisser vide dès que Firebase Admin est configuré.
ZIRA_DEMO_MODE=true
# Rôle simulé en mode démo : super_admin | support | billing | viewer
ZIRA_DEMO_ROLE=support

# ---- Firebase Web (connexion du personnel uniquement ; le navigateur ne lit pas Firestore)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (serveur uniquement). Préférer les identifiants par défaut de
# l'environnement (Cloud Run / Secret Manager). Sinon, compte de service en variables :
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_API_KEY=
FIREBASE_PRIVATE_KEY=


# ---- API d'administration Zira (fleet_backend NestJS, routes /admin/v1/* — BACKOFFICE_API.md)
# Local : http://localhost:3000 · Production : https://api.zira.ci
# Les appels sont authentifiés avec l'ID token Firebase du membre du personnel (pas de jeton de service).
# Le projet Firebase doit être le MÊME que celui du backend (audience du token).
ADMIN_API_URL=https://api.zira.ci

# Double authentification exigée à la connexion (mettre false uniquement en staging)
ZIRA_REQUIRE_MFA=true
