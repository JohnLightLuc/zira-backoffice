# ---- Environnement affiché dans l'en-tête : production | staging | development
NEXT_PUBLIC_ZIRA_ENV=development

# ---- Mode démo (données fictives, aucun accès Firebase). Interdit en production.
# Laisser vide dès que Firebase Admin est configuré.
ZIRA_DEMO_MODE=true
# Rôle simulé en mode démo : super_admin | support | billing | viewer
ZIRA_DEMO_ROLE=support

# ---- Firebase Web (connexion du personnel uniquement ; le navigateur ne lit pas Firestore)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ---- Firebase Admin (serveur uniquement). Préférer les identifiants par défaut de
# l'environnement (Cloud Run / Secret Manager). Sinon, compte de service en variables :
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Clé privée avec les \n échappés
FIREBASE_PRIVATE_KEY=

# ---- API d'administration Zira (routes /admin/v1/* à créer côté backend, cf. spec §8)
ZIRA_ADMIN_API_URL=
# Jeton de service serveur→serveur (Secret Manager). Jamais exposé au navigateur.
ZIRA_ADMIN_API_TOKEN=

# Durée de la session staff (jours, 1 à 14)
SESSION_DAYS=1
